# Copy this file to `.env` for Docker Compose deployment.
# PostgreSQL >= 15 is required by Prisma ORM 8.

# Application
NODE_ENV=production

# Ports
FRONTEND_PORT=3000
BACKEND_PORT=4000
POSTGRES_PORT=5432

# Authentication (shared between Backend API Guard and Frontend Server Proxy)
API_KEY=change-me

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=discord_scheduler
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/discord_scheduler

# CORS
CORS_ORIGIN=http://localhost:3000

# Optional Scheduler & Webhook Tuning
SCHEDULER_POLL_MS=5000
SCHEDULER_BATCH_SIZE=20
SCHEDULER_LEASE_MS=300000
WEBHOOK_TIMEOUT_MS=10000
RETRY_BASE_DELAY_MS=2000
RETRY_MAX_DELAY_MS=60000
ALLOW_NON_DISCORD_WEBHOOKS=false
